# ============================================================
# .env.example — Template for environment variables
# ============================================================
# Copy this file to ".env" and fill in your own values.
# The real ".env" is in .gitignore and will NOT be committed.
#
# How to use on Windows (PowerShell):
#   Copy-Item .env.example .env
# ============================================================

# Absolute path to the extracted chest_xray dataset folder.
# Example (Windows):  C:\Users\YourName\Downloads\chest_xray
# Example (Linux/Mac): /home/yourname/datasets/chest_xray
DATASET_ROOT=

# Device override: "cuda" forces GPU, "cpu" forces CPU.
# Leave blank to let the code auto-detect.
DEVICE=

# Random seed for reproducibility (default: 42)
RANDOM_SEED=42
