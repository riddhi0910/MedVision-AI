# ============================================================
# .gitignore — Files that Git will NEVER commit
# ============================================================
# Why this matters: datasets are huge (> 1 GB), model weights
# can be hundreds of MB, and .env files contain secrets.
# We tell Git to skip all of them.
# ============================================================

# Python cache files (auto-generated, not needed in Git)
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
*.env

# Node & Frontend dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Dataset — never commit medical images or huge archives to Git
data/
chest_xray/
*.zip
*.tar.gz
*.tar
*.gz
*.7z
*.rar

# Model checkpoints and weights (large binary files > 40MB)
*.pth
*.pt
*.ckpt
*.h5
*.onnx
*.bin

# Keep empty checkpoint folders via .gitkeep
!**/.gitkeep

# Jupyter notebook checkpoints
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints

# Logs
*.log
artifacts/logs/
logs/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Coverage and test artefacts
.coverage
htmlcov/
.pytest_cache/
